# Variáveis usadas pelo docker-compose.yml (copie para .env na raiz do repo).
# As variáveis específicas do backend ficam em backend/.env (veja backend/.env.example).

POSTGRES_PASSWORD=

# URL pública da API (subdomínio configurado no Caddyfile), usada pelo frontend
# tanto pra chamadas server-side quanto pras URLs de capa de livro renderizadas
# no HTML.
FLASK_API_URL=https://api.seu-dominio.com

# Mesmo Client ID configurado em backend/.env como GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
