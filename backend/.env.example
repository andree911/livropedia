# Copie para .env e preencha antes de rodar em produção.

# Postgres compartilhado da VPS (/opt/infra/postgres), acessado pela rede
# Docker externa "db". Banco e usuário "livropedia" criados dentro dele.
DATABASE_URL=postgresql://livropedia:CHANGE_ME@postgres:5432/livropedia

# Gere valores aleatórios fortes, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# OAuth do Google (console.cloud.google.com > APIs & Services > Credentials).
# Precisa ser o mesmo Client ID usado no frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID
# configurado no Vercel).
GOOGLE_CLIENT_ID=

# Envio de e-mail (recuperação de senha) via SMTP do Gmail.
SMTP_USER=
SMTP_PASSWORD=

# URL pública do frontend (deploy no Vercel), usada em links de e-mail
# (recuperação de senha etc).
FRONTEND_URL=https://livropedia.vercel.app

# Chave da Anthropic, usada como fallback na normalização de busca.
ANTHROPIC_API_KEY=

# Chave da Google Books API, usada na busca de livros externos.
GOOGLE_BOOKS_API_KEY=
