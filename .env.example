# Variáveis usadas pelo docker-compose.yml (copie para .env na raiz do repo).
# As variáveis específicas do backend ficam em backend/.env (veja backend/.env.example).
#
# Não tem POSTGRES_PASSWORD aqui: o Postgres é compartilhado na VPS
# (/opt/infra/postgres), não sobe junto com este projeto.

# URL pública da API (roteada pelo Traefik compartilhado da VPS), usada pelo
# frontend tanto pra chamadas server-side quanto pras URLs de capa de livro
# renderizadas no HTML.
FLASK_API_URL=https://srv1892430.hstgr.cloud:3003

# Mesmo Client ID configurado em backend/.env como GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
