# Copie para .env.local e ajuste conforme o ambiente.
# Dev local: aponta pro Flask rodando na sua máquina.
FLASK_API_URL=http://127.0.0.1:5001

# Produção: aponta pro Flask hospedado (ex: Render).
# FLASK_API_URL=https://controle-de-livros-backend-1.onrender.com

# Client ID do OAuth do Google (console.cloud.google.com > APIs & Services
# > Credentials). Não é segredo — precisa mesmo ir pro bundle do navegador,
# por isso o prefixo NEXT_PUBLIC_. O mesmo valor também precisa estar no
# backend como GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
