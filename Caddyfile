# Substitua os domínios abaixo pelos seus antes do deploy.
# Caddy emite e renova HTTPS automaticamente (Let's Encrypt) — só precisa
# que o DNS dos dois domínios já esteja apontando pro IP da VPS.

seu-dominio.com {
    reverse_proxy frontend:3000
}

api.seu-dominio.com {
    reverse_proxy backend:5001
}
